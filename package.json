{
  "name": "opencode-quill",
  "version": "0.1.0",
  "description": "Local word autocomplete for the OpenCode V2 prompt composer.",
  "type": "module",
  "license": "MIT",
  "author": "Ozan Dogrultan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozandogrultan/opencode-quill.git"
  },
  "homepage": "https://github.com/ozandogrultan/opencode-quill#readme",
  "bugs": {
    "url": "https://github.com/ozandogrultan/opencode-quill/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "autocomplete",
    "autosuggest",
    "ngram",
    "prompt"
  ],
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "tsconfig.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "opencode": ">=2.0.26"
  },
  "scripts": {
    "prepare": "husky",
    "test": "bun test && bash tests/changelog.sh",
    "test:unit": "bun test",
    "test:changelog": "bash tests/changelog.sh",
    "typecheck": "tsc --noEmit",
    "lint:sh": "for script in install.sh tests/*.sh scripts/*.sh; do bash -n \"$script\" || exit; done",
    "prepublishOnly": "bun run test && bun run typecheck"
  },
  "dependencies": {
    "subtlex-word-frequencies": "2.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@opencode/plugin": "2.0.26",
    "@opentui/core": "^0.5.17",
    "@opentui/solid": "^0.5.17",
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.4",
    "husky": "^9.1.7",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  }
}
